{
  "name": "playwright-demo-framework",
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "pretest": "mkdir -p reports test-results",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "test:ci": "ENV=ci playwright test",
    "test:prod": "ENV=prod playwright test",
    "test:ci:headed": "ENV=ci playwright test --headed",
    "test:prod:headed": "ENV=prod playwright test --headed",
    "debug": "playwright test --debug",
    "debug:ci": "ENV=ci playwright test --debug",
    "debug:prod": "ENV=prod playwright test --debug",
    "install:browsers": "npx playwright install chromium --with-deps"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.8.0",
    "@playwright/test": "^1.53.1",
    "@testmo/testmo-cli": "^1.4.4",
    "@types/node": "^24.0.3",
    "@zealteam/testrail-reporter": "^1.0.17",
    "chalk": "^5.3.0",
    "dotenv": "^16.5.0",
    "dotenv-cli": "^8.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "axios": "^1.10.0",
    "form-data": "^4.0.3"
  }
}